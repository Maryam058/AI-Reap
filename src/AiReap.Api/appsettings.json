{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "AiReap",
    "Audience": "AiReapClient",
    "ExpiryMinutes": 120
  },
  "Ai": {
    "Provider": "Anthropic",
    "EmbeddingProvider": "",
    "Gemini": {
      "EmbeddingModel": "gemini-embedding-001",
      "EmbeddingDimensions": 768
    },
    "Resilience": {
      "TimeoutSeconds": 120,
      "MaxAttempts": 3,
      "BaseDelayMilliseconds": 1000,
      "MaxDelaySeconds": 20,
      "MaxRetryAfterSeconds": 30,
      "MaxRateLimitAttempts": 2
    },
    "Anthropic": {
      "Model": "claude-sonnet-5-5",
      "MaxTokens": 16000,
      "MaxRequestTokens": 200000,
      "ContextWindowTokens": 1000000,
      "EstimatedCharsPerToken": 2.5,
      "MaxChunkedParts": 8,
      "GenerationPartSourceTokens": 6000,
      "MaxGenerationParts": 24,
      "TimeoutSeconds": 600,
      "MaxTimeoutAttempts": 1,
      "UseTokenCountingApi": false
    },
    "OpenAI": {
      "Model": "text-embedding-3-small"
    }
  },
  "ClarificationVisibility": {
    "WarmOnStartup": true,
    "WarmStartDelaySeconds": 5,
    "WarmMaxSources": 200,
    "WarmMaxSeconds": 300
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  }
}
